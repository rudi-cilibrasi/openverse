# Edge of the identifier limit (#724): a field of exactly 1024 characters.
# Epic refuses 1025 (3655) and let a class's name of 1024 pass that check
# (to fail with 9002). OpenVerse admits it and prints
#   field 42
# Run it alone (single mode).
# Epic's compiler (UEFN 43.12, ++Fortnite+Release-43.12-CL-60598086,
# BuildAll, 2026-11-19) refuses it: 3655 (L6) "Identifier is too long".
holder := class:
    :int = 42

Main():void =
    Obj := holder{}
    Print("OVPROBE field {Obj.}")
