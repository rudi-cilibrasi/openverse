# Edge of the identifier limit (#724): a module function of exactly 1024
# characters; the Blueprint VM's names hold 1023, as for a class (9002 at
# 1024). OpenVerse admits it and prints
#   result 42
# If Epic refuses it, a function's name is limited as a class's is. Run it
# alone (single mode).
# Epic's compiler (UEFN 43.12, ++Fortnite+Release-43.12-CL-60598086,
# BuildAll, 2026-11-19) refuses it: 3655 (L6) "Identifier is too long".
():int = 42

Main():void =
    Print("OVPROBE result {()}")
