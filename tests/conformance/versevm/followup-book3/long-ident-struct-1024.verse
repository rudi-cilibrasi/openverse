# Edge of the class-name limit (#724): a struct of 1024 characters (a class
# of 1024 is refused, 9002). OpenVerse limits classes only, and prints
#   field 42
# Run it alone (single mode).
# Epic's compiler (UEFN 43.12, ++Fortnite+Release-43.12-CL-60598086,
# BuildAll, 2026-11-19) refuses it: 9002 (L4) "Cannot find struct:
# `Struct__`.".
Struct__ := struct:
    V:int = 42

Main():void =
    S := Struct__{}
    Print("OVPROBE field {S.V}")
