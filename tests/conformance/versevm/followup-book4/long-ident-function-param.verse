# Edge of the length rules (#724): a module function of 990 characters, the
# most measured without parameters, with a parameter X:int. OpenVerse admits
# it and prints
#   result 42
# If Epic refuses it, parameters lower a function's limit. Run it alone
# (single mode).
# Epic's compiler (UEFN 43.12, ++Fortnite+Release-43.12-CL-60598086,
# BuildAll, 2026-11-19) refuses it: 3655 (L6) "Identifier is too long".
# OpenVerse admits it: a known difference.
(X:int):int = X

Main():void =
    Print("OVPROBE result {(42)}")
