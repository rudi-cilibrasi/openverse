# Edge of the length rules (#724): an enum of 1023 characters. OpenVerse
# admits it (an identifier of at most 1024) and prints
#   compared
# If Epic refuses it, an enum's name is limited as a class's or less. Run it
# alone (single mode).
Enum____ := enum:
    A
    B

Main():void =
    X:Enum____ = Enum____.A
    if (X = Enum____.A):
        Print("OVPROBE compared")
