Sinh(X:int)<computes>:int=X+1
Cosh(X:int)<computes>:int=X+2
Tanh(X:int)<computes>:int=X+3
ArSinh(X:int)<computes>:int=X+4
ArCosh(X:int)<computes>:int=X+5
ArTanh(X:int)<computes>:int=X+6
Lerp(A:int,B:int,P:int)<computes>:int=A+B+P
Main()<computes>:void=Print("{Sinh(10)} {Cosh(10)} {Tanh(10)} {ArSinh(10)} {ArCosh(10)} {ArTanh(10)} {Lerp(1,2,3)}")
