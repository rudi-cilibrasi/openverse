    Print("L       <> {if (L <> false) then "y" else "n"}{if (L <> L) then "y" else "n"}{if (L <> ()) then "y" else "n"}{if (L <> V) then "y" else "n"}{if (L <> T) then "y" else "n"}{if (L <> O) then "y" else "n"}{if (L <> array{}) then "y" else "n"}{if (L <> A) then "y" else "n"}{if (L <> "") then "y" else "n"}{if (L <> S) then "y" else "n"}{if (L <> map{}) then "y" else "n"}{if (L <> M) then "y" else "n"}")
