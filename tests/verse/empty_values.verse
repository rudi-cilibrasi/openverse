# Verse has one empty value (Book of Verse ch. 2, "void, true, tuple() and
# false"): `false`, `()`, a `void` or `tuple()` value, an empty option,
# array, string and map are that value, whatever their types, so = between
# any two of them holds and <> fails, in either order; a non-empty value is
# none of them. Each line is one left operand against every right operand,
# in the order of the names below (y: the comparison holds, n: it fails).
#   false L () V T O array{} A "" S map{} M

Mark(B:logic):string = if (B?) then "y" else "n"

# Through parameters of each type.
Params(L:logic, V:void, T:tuple(), O:?int, A:[]int, S:string, M:[int]int):void =
    Print("L  =  {if (L = L) then "y" else "n"}{if (L = V) then "y" else "n"}{if (L = T) then "y" else "n"}{if (L = O) then "y" else "n"}{if (L = A) then "y" else "n"}{if (L = S) then "y" else "n"}{if (L = M) then "y" else "n"}")
    Print("V  =  {if (V = L) then "y" else "n"}{if (V = V) then "y" else "n"}{if (V = T) then "y" else "n"}{if (V = O) then "y" else "n"}{if (V = A) then "y" else "n"}{if (V = S) then "y" else "n"}{if (V = M) then "y" else "n"}")
    Print("T  =  {if (T = L) then "y" else "n"}{if (T = V) then "y" else "n"}{if (T = T) then "y" else "n"}{if (T = O) then "y" else "n"}{if (T = A) then "y" else "n"}{if (T = S) then "y" else "n"}{if (T = M) then "y" else "n"}")
    Print("O  =  {if (O = L) then "y" else "n"}{if (O = V) then "y" else "n"}{if (O = T) then "y" else "n"}{if (O = O) then "y" else "n"}{if (O = A) then "y" else "n"}{if (O = S) then "y" else "n"}{if (O = M) then "y" else "n"}")
    Print("A  =  {if (A = L) then "y" else "n"}{if (A = V) then "y" else "n"}{if (A = T) then "y" else "n"}{if (A = O) then "y" else "n"}{if (A = A) then "y" else "n"}{if (A = S) then "y" else "n"}{if (A = M) then "y" else "n"}")
    Print("S  =  {if (S = L) then "y" else "n"}{if (S = V) then "y" else "n"}{if (S = T) then "y" else "n"}{if (S = O) then "y" else "n"}{if (S = A) then "y" else "n"}{if (S = S) then "y" else "n"}{if (S = M) then "y" else "n"}")
    Print("M  =  {if (M = L) then "y" else "n"}{if (M = V) then "y" else "n"}{if (M = T) then "y" else "n"}{if (M = O) then "y" else "n"}{if (M = A) then "y" else "n"}{if (M = S) then "y" else "n"}{if (M = M) then "y" else "n"}")
    Print("L  <> {if (L <> L) then "y" else "n"}{if (L <> V) then "y" else "n"}{if (L <> T) then "y" else "n"}{if (L <> O) then "y" else "n"}{if (L <> A) then "y" else "n"}{if (L <> S) then "y" else "n"}{if (L <> M) then "y" else "n"}")
    Print("V  <> {if (V <> L) then "y" else "n"}{if (V <> V) then "y" else "n"}{if (V <> T) then "y" else "n"}{if (V <> O) then "y" else "n"}{if (V <> A) then "y" else "n"}{if (V <> S) then "y" else "n"}{if (V <> M) then "y" else "n"}")
