# functions with several values (#235), review case b3-fib28
F0(X:int):int = X | X + 1
F1(X:int):int = X + 1 | X
F2(X:int):int = F1(X) + F0(X)
F3(X:int):int = F2(X) + F1(X)
F4(X:int):int = F3(X) + F2(X)
F5(X:int):int = F4(X) + F3(X)
F6(X:int):int = F5(X) + F4(X)
F7(X:int):int = F6(X) + F5(X)
F8(X:int):int = F7(X) + F6(X)
F9(X:int):int = F8(X) + F7(X)
F10(X:int):int = F9(X) + F8(X)
F11(X:int):int = F10(X) + F9(X)
F12(X:int):int = F11(X) + F10(X)
F13(X:int):int = F12(X) + F11(X)
F14(X:int):int = F13(X) + F12(X)
F15(X:int):int = F14(X) + F13(X)
F16(X:int):int = F15(X) + F14(X)
F17(X:int):int = F16(X) + F15(X)
F18(X:int):int = F17(X) + F16(X)
F19(X:int):int = F18(X) + F17(X)
F20(X:int):int = F19(X) + F18(X)
F21(X:int):int = F20(X) + F19(X)
F22(X:int):int = F21(X) + F20(X)
F23(X:int):int = F22(X) + F21(X)
F24(X:int):int = F23(X) + F22(X)
F25(X:int):int = F24(X) + F23(X)
F26(X:int):int = F25(X) + F24(X)
F27(X:int):int = F26(X) + F25(X)
Main():void =
    for (V := F0(1)) { Print("{V}") }
