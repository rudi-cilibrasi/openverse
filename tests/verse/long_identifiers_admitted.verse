# Long names Epic's compiler takes (#724), measured on UEFN 43.12
# (++Fortnite+Release-43.12-CL-60598086, followup-book3/expectations.tsv):
# the Book's class of 960 characters with a field of 992 and a method F()
# (runs on the Verse VM, followup-book2/long-ident-class-1024-control:
# field 42); a field and a local of 1004, a function of 990, a class of 976
# with a method Function() (984 together, followup-book3/long-ident-mangled-no-params),
# and a parameter of 1005 (admitted, followup-book4/long-ident-parameter-1005).
Class___ := class:
    Var_____:int = 42
    F():int = 1
holder := class:
    :int = 7
Class2__ := class:
    Function():int = 3
():int = 5
Echo(:int):int = 
Main():void =
    Print("field {Class___{}.Var_____} {Class___{}.F()}")
    Print("longest {holder{}.}")
    :int = 9
    Print("local {} function {()} method {Class2__{}.Function()}")
    Print("parameter {Echo(11)}")
